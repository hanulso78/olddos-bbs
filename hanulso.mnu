			<!-- 인터넷의 무료 AI 와 묻고 답하기 (설정은 hanulso.cfg 의 <ai>) -->
			<item type="program" prog="aichat" go="ai" door="16" access_level="1">
				<name>AI 와 이야기 (ai)</name>
			</item>

			<!-- 도로명주소 검색 API (승인키는 hanulso.cfg 의 <juso><key>) -->
			<item type="program" prog="zipcode" go="zip" door="17" access_level="1">
				<name>우편번호 찾기 (zip)</name>
			</item>
		</item>

		<item type="menu" text="txt/game_info.txt" go="game" door="7">
			<item type="program" prog="hero" go="hero" door="1" access_level="1">
				<name>용사의 전설 (hero)</name>
			</item>

			<!-- 같은 서버에서 따로 띄운 머드(MudOS)에 연결. args 는 포트 -->
			<item type="program" prog="mudlink" args="4444" go="jurassic" door="2" access_level="1">
				<name>쥬라기공원 2 (jurassic)</name>
			</item>

			<!-- 무한대전 (Mordor 기반, 금오공대 한글판). src/muhan 에서 따로 띄움. args 는 포트 -->
			<item type="program" prog="mudlink" args="4100" go="muhan" door="3" access_level="1">
				<name>무한대전 (muhan)</name>
			</item>

			<!-- 산성비 타자 게임 -->
			<item type="program" prog="rain" go="rain" door="4" access_level="1">
				<name>산성비 (rain)</name>
			</item>

			<!-- 오목 (사람끼리 / 컴퓨터와) -->
			<item type="program" prog="omok" go="omok" door="5" access_level="1">
				<name>오목 (omok)</name>
			</item>

			<item type="program" prog="baseball" go="baseball" door="6" access_level="1">
				<name>숫자야구 (baseball)</name>
			</item>

			<item type="program" prog="mine" go="mine" door="7" access_level="1">
				<name>지뢰찾기 (mine)</name>
			</item>

			<item type="program" prog="blackjack" go="blackjack" door="8" access_level="1">
				<name>블랙잭 (blackjack)</name>
			</item>

			<!-- 타자 연습 (긴 글 따라 치기, 타수 / 정확도, 오늘의 도전) -->
			<item type="program" prog="typing" go="typing" door="9" access_level="1">
				<name>타자 연습 (typing)</name>
			</item>

			<!-- 조크 I (Infocom 1980) 한글판. src/zork1 (원작 게임 파일 + 번역표), 1 인용, 아이디별 저장 -->
			<item type="program" prog="zork1" go="zork" door="10" access_level="1">
				<name>조크 I (zork)</name>
			</item>
		</item>

		
