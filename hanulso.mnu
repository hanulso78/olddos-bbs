<?xml version="1.0" encoding="euc-kr"?>
<hanulso>
	<item type="menu" text="txt/top.txt" go="top">
		<header>txt/header.txt</header>
		<footer>txt/footer.txt</footer>

		<!------------------------------------------------------------->
		<item type="board" go="notice" id="bbs_notice" door="1" access_level="1">
			<name>공지 (notice)</name>
			<attachment>yes</attachment>
			<write_sysop_only>yes</write_sysop_only>
			<reply>no</reply>
			<header>txt/header.txt</header>
			<footer></footer>
		</item>

		<item type="board" go="welcome" id="bbs_hello" door="2" access_level="1">
