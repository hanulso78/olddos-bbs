# 비밀번호가 들어 있는 설정 파일
hanulso.cfg

# 에디터 임시 파일
*.swp
*.swo
.*.sw[a-p]
*~

# 덤프 이미지
dump/

# 참고 자료 (권리 미확인, 저장소에 올리지 않음)
ref/
# 쥬라기공원 머드 라이브러리 원본 (권리 미확인, 서버에서 jp2_v15.tgz 를 풀어 둠)
src/jurassic/lib/

# 대화방 서버가 만드는 방 정보와 대화 기록
